{
  "name": "paramify-icp",
  "version": "2.0.0",
  "description": "Decentralized flood insurance platform on Internet Computer",
  "private": true,
  "workspaces": [
    "frontend",
    "scripts"
  ],
  "scripts": {
    "setup": "npm install && bash setup-wsl-icp.sh",
    "build": "dfx build",
    "build:canister": "cargo build --manifest-path=canister/Cargo.toml --release --target wasm32-unknown-unknown",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "dfx deploy --network local",
    "deploy:ic": "dfx deploy --network ic",
    "start": "dfx start --clean --background",
    "stop": "dfx stop",
    "test": "cargo test --manifest-path=canister/Cargo.toml",
    "clean": "rm -rf .dfx target node_modules frontend/node_modules frontend/dist",
    "reset": "npm run clean && dfx start --clean --background",
    "canister:status": "dfx canister status paramify_insurance --network local",
    "canister:call:create_policy": "dfx canister call paramify_insurance create_policy '(record {coverage_amount = 100000000})' --network local",
    "canister:call:get_flood_data": "dfx canister call paramify_insurance get_flood_data --network local",
    "canister:call:get_status": "dfx canister call paramify_insurance get_system_status --network local",
    "oracle:start": "cd backend && npm start",
    "oracle:update": "curl -X POST http://localhost:3001/update",
    "dev": "npm run start && npm run deploy && npm run oracle:start",
    "dev:frontend": "cd frontend && npm run dev",
    "identity:create": "dfx identity new --storage-mode=plaintext",
    "identity:list": "dfx identity list",
    "wsl:sync": "bash sync-to-windows.sh"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@dfinity/agent": "^1.1.0",
    "@dfinity/principal": "^1.1.0",
    "@dfinity/candid": "^1.1.0",
    "@dfinity/identity": "^1.1.0",
    "@dfinity/auth-client": "^1.1.0",
    "prettier": "^3.2.4",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.1",
  },
  "dependencies": {
    "dotenv": "^16.4.1",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielabrahamx/Paramify.git"
  },
  "keywords": [
    "blockchain",
    "insurance",
    "parametric",
    "flood",
    "icp",
    "internet-computer",
    "web3",
    "defi"
  ],
  "author": "Paramify Development Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danielabrahamx/Paramify/issues"
  },
  "homepage": "https://github.com/danielabrahamx/Paramify#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write",
    "*.rs": "cargo fmt --"
  }
}