{
  "version": 1,
  "canisters": {
    "paramify_insurance": {
      "type": "rust",
      "package": "paramify_canister",
      "candid": "canister/paramify.did"
    },
    "frontend": {
      "type": "assets",
      "source": ["frontend/dist"],
      "dependencies": ["paramify_insurance"]
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "ephemeral"
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  }
}
